{
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://rw-milk-track.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy.html"
    },
    {
      "source": "/delete-account.html",
      "destination": "/delete-account.html"
    },
    {
      "source": "/((?!assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
